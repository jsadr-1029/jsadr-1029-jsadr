# =====================================================
# .env.example — Plantilla completa de variables de entorno
# JSADR Plataforma de Gestión de Préstamos
# =====================================================
# COPIA este archivo a .env.local (desarrollo) o configura
# cada variable en el dashboard de Vercel (producción).
#
# Genera secretos aleatorios con:
#   openssl rand -hex 32
# =====================================================

# =====================================================
# 1. BASE DE DATOS
# =====================================================
# Desarrollo local (SQLite):
DATABASE_URL="file:./db/custom.db"

# Producción (Neon PostgreSQL):
# DATABASE_URL="postgresql://USER:PASSWORD@ep-COOL-REGION.aws.neon.tech/DBNAME?sslmode=require&schema=public"
# Neon pooling (recomendado para serverless):
# DATABASE_URL_DIRECT="postgresql://USER:PASSWORD@ep-COOL-REGION-pooler.aws.neon.tech/DBNAME?sslmode=require&schema=public"

# =====================================================
# 2. SECRETOS DE AUTENTICACIÓN (generar con: openssl rand -hex 32)
# =====================================================
# JWT para access tokens (15 min de validez)
JWT_SECRET=""
# JWT para refresh tokens (7 días de validez)
JWT_REFRESH_SECRET=""
# Cifrado AES-256-GCM de API keys almacenadas en BD (PlataformaSync.tokenCifrado)
API_ENCRYPTION_KEY=""
# Sesiones OTP del chat del portal (HMAC-SHA256)
OTP_CHAT_SECRET=""
# Sesiones del portal del cliente (tokenSesion en tabla Cliente)
PORTAL_SESSION_SECRET=""
# Sesiones de administración (sessionToken en tabla Usuario)
ADMIN_SESSION_SECRET=""
# FIX-SEGURIDAD-CRITICA #2: secreto del servidor para claves dinámicas del chat (≥32 chars)
# Generar con: openssl rand -hex 32
CHAT_DYN_SECRET=""

# =====================================================
# 3. CORS / CSRF — orígenes permitidos (coma separado)
# =====================================================
ALLOWED_ORIGINS="https://localhost:3000,https://preview-*.space-z.ai,https://jsadr.com.co,https://www.jsadr.com.co"

# =====================================================
# 4. PLATAFORMAS DE SINCRONIZACIÓN (Módulo de Seguridad)
# =====================================================
# Estos tokens se usan para sincronización automática desde el backend.
# También pueden configurarse desde el Módulo de Seguridad → Plataformas → Configurar.

# GitHub (PAT con permisos: repo, workflow, webhook, read:user)
GITHUB_TOKEN=""
GITHUB_OWNER="jsadr-1029"
GITHUB_REPO="jsadr"
GITHUB_WEBHOOK_SECRET=""

# Vercel (token desde Account Settings → Tokens)
VERCEL_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""
VERCEL_WEBHOOK_SECRET=""

# Neon (API key desde Account → API Keys)
NEON_API_KEY=""
NEON_PROJECT_ID="rapid-darkness-56995142"
NEON_BRANCH="main"
NEON_WEBHOOK_SECRET=""

# =====================================================
# 5. WHATSAPP CLOUD API (Meta Business)
# =====================================================
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ID=""
WHATSAPP_WEBHOOK_SECRET=""

# =====================================================
# 6. EMAIL SMTP (configuración principal)
# =====================================================
# Correo principal de la plataforma: jsa@jsadr.com.co
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="jsa@jsadr.com.co"
SMTP_PASS=""
SMTP_FROM="jsa@jsadr.com.co"
SMTP_FROM_NAME="JSADR Plataforma"

# Si usas Outlook/Office365:
# SMTP_HOST="smtp.office365.com"
# SMTP_PORT="587"

# Si usas SendGrid:
# SMTP_HOST="smtp.sendgrid.net"
# SMTP_PORT="587"
# SMTP_USER="apikey"
# SMTP_PASS="SG.xxxxxxxx"

# =====================================================
# 6.1 BREVO (Sendinblue) — HTTPS API + SMTP relay
# =====================================================
# Estas variables de entorno son usadas por el backend (src/lib/email.ts)
# como camino principal para enviar correos vía HTTPS API de Brevo.
# Si no están definidas, el sistema busca las credenciales en la BD
# (tabla ConexionAPI, tipo=EMAIL_SMTP).
#
# Genera tus claves en: https://app.brevo.com/settings/keys/api
#
# BREVO_API_KEY: API key v3 (empieza con "xkeysib-")
#   - Permite llamadas HTTPS a https://api.brevo.com/v3/*
#   - Verificación de cuenta: GET /v3/account
#   - Envío de correo: POST /v3/smtp/email
BREVO_API_KEY=""

# BREVO_SMTP_KEY: SMTP key (empieza con "xsmtpsib-")
#   - Usada para autenticación SMTP relay en smtp-relay.brevo.com:587
#   - Fallback si la HTTPS API falla o devuelve 401/403
BREVO_SMTP_KEY=""

# Brevo sender (email verificado en el panel de Brevo)
BREVO_FROM_EMAIL="jsa@jsadr.com.co"
BREVO_FROM_NAME="JSADR Plataforma"

# =====================================================
# 7. ENTORNO
# =====================================================
NODE_ENV="development"
# En Vercel: NODE_ENV se setea automáticamente a "production"

# URL pública de la aplicación (para webhooks y links enviados al cliente)
# En desarrollo local:
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
# En producción (Vercel):
NEXT_PUBLIC_APP_URL="https://jsadr.com.co"
# Alias legacy (lo usa src/lib/url.ts -> getBaseUrl() como segunda prioridad):
NEXT_PUBLIC_BASE_URL="https://jsadr.com.co"

# =====================================================
# 8. OPCIONALES — ANALÍTICA Y MONITOREO
# =====================================================
# Sentry (error tracking)
SENTRY_DSN=""

# Vercel Analytics (se activa automáticamente si el proyecto está en Vercel)
# No requiere variable de entorno

# Google Analytics
NEXT_PUBLIC_GA_ID=""

# =====================================================
# 9. BANCOLOMBIA — Botón de Pago (Persona Natural)
# =====================================================
# Las credenciales reales se guardan en la BD (tabla ConexionAPI,
# tipo=BANCOLOMBIA_BOTON_PAGO) y se gestionan desde la UI:
#   Configuración Global → Integraciones → Botón Bancolombia
#
# Estas variables de entorno son SOLO para el backend (server-side):
# se usan como fallback si no hay credenciales en BD.

BANCOLOMBIA_CLIENT_ID=""
BANCOLOMBIA_CLIENT_SECRET=""
BANCOLOMBIA_COMMERCE_ID=""
BANCOLOMBIA_AMBIENTE="sandbox"  # sandbox | produccion

# URL pública de tu app (Vercel o dominio custom)
# Necesaria para que Bancolombia sepa a dónde redirigir y notificar
# NOTA: NEXT_PUBLIC_APP_URL ya está definida arriba como https://jsadr.com.co
# Si necesitas un dominio distinto para Bancolombia, descomenta y edita:
# BANCOLOMBIA_RETURN_URL="https://jsadr-jsadr.vercel.app"

# Endpoints del sistema (no cambiar):
#   POST /api/pagos/bancolombia-checkout   — crear intención de pago
#   GET  /api/pagos/bancolombia-redirect   — vuelta del cliente
#   POST /api/pagos/bancolombia-webhook    — notificación asíncrona
#   POST /api/configuracion-global/bancolombia           — guardar credenciales
#   POST /api/configuracion-global/bancolombia/probar    — probar conexión
