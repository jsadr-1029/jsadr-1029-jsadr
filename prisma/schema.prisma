// =====================================================
// Sistema de Gestión de Préstamos v3.0 - Jo*** Se*** Al*** D** R**
// Modelo bancario con intereses fijos sobre capital inicial
// Mora compuesta diaria + cajas menores + portal cliente
// Usuarios con roles (Admin/Gestor/Consultor) + Bitácora + Reversar pagos
// v3.0: Automatizaciones + Versiones + Backups + Acceso Portal
// =====================================================

generator client {
  provider = "prisma-client-js"
}

// =====================================================
// Datasource:
//  - Unificado (local + Vercel): PostgreSQL en Neon
//    DATABASE_URL="postgresql://USER:PASS@HOST/DB?sslmode=require&schema=public"
//  - Local usa el mismo Neon que Vercel → no hay drift de credenciales
//  - SQLite local fue migrado a Neon en 2026-08-04 (326 registros, 32 tablas)
//    El archivo db/custom.db se mantiene solo como backup histórico.
// =====================================================
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------
// USUARIO DEL SISTEMA (con roles, permisos y seguridad)
// -----------------------------------------------------
model Usuario {
  id              String   @id @default(cuid())
  nombre          String
  email           String   @unique
  username        String   @unique
  passwordHash    String   // Bcrypt rounds=12
  rol             String   // ADMIN | GESTOR | CONSULTOR | ABOGADO
  activo          Boolean  @default(true)
  ultimoAcceso    DateTime?
  permisos        String?  // JSON con permisos específicos
  // === Identidad del portal jurídico (abogados/gestores) ===
  cedula          String?  @unique // Cédula del abogado para login del portal jurídico
  claveHash       String?  // Hash bcrypt de la clave del portal jurídico (independiente del passwordHash del admin)
  tokenSesion     String?  // Token de sesión del portal jurídico (randomBytes)
  tokenExpira     DateTime? // Expiración del token de sesión del portal jurídico
  // Seguridad
  intentosFallidos Int    @default(0)
  bloqueadoHasta   DateTime?
  mfaEnabled       Boolean @default(false)
  mfaSecret        String?  // TOTP secret (base32)
  sessionToken     String?  // JWT refresh token hash
  mustChangePassword Boolean @default(false)
  // === Recuperación de clave por magic link (v4.14) ===
  // Reemplaza el envío de contraseña temporal: ahora se envía un enlace
  // firmado al correo del usuario con un token de un solo uso.
  claveResetToken  String?
  claveResetExpira DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bitacoras       BitacoraPrestamo[]
  pagosReversados Pago[]
  pagosAnulados   Pago[] @relation("PagoAnuladoPor")
  movimientosCaja MovimientoCaja[]
  auditLogs       AuditLog[]
  conversacionesAsesor ConversacionChat[] @relation("AsesorConversaciones")
  notasInternasChat NotaInterna[] @relation("AutorNotasInternas")
}

// -----------------------------------------------------
// CLIENTE / EMPLEADO
// -----------------------------------------------------
model Cliente {
  id              String   @id @default(cuid())
  nombre          String
  cedula          String   @unique
  telefono        String
  // v4.5 (QA M02-Clientes TC-CLI-014): email único a nivel BD para prevenir suplantación.
  // PostgreSQL permite múltiples NULLs en columnas UNIQUE nullable, así que
  // los clientes sin email no se ven afectados.
  email           String?  @unique
  // "Cargo" fue reemplazado por "Referido por" (relación a otro Cliente)
  departamento    String?
  municipio       String?
  salario         Float?
  fechaIngreso    DateTime?
  direccion       String?
  ciudad          String?
  barrio          String?
  notas           String?
  // Datos bancarios del cliente (para pagos/descuentos)
  bancoCliente        String?
  tipoCuentaCliente   String?  // AHORROS | CORRIENTE
  numeroCuentaCliente String?
  // Estado del cliente (activo/inactivo)
  activo          Boolean  @default(true)
  // v4.12 (QA M09 TC-NOT-015): cliente desuscrito de notificaciones automáticas
  optOutNotificaciones Boolean @default(false)
  // === Autenticación del portal (PIN de 4 dígitos) ===
  pinHash            String?
  pinCreatedAt       DateTime?
  pinIntentos        Int      @default(0)
  pinBloqueadoHasta  DateTime?
  ultimoAccesoPortal DateTime?
  // === Clave alfanumérica del cliente (más robusta que el PIN) ===
  // Permite al cliente iniciar sesión con cédula + clave en el portal.
  // El gestor puede regenerarla desde el módulo de Seguridad cuando el cliente olvida.
  claveHash             String?
  claveCreatedAt        DateTime?
  claveIntentos         Int      @default(0)
  claveBloqueadoHasta   DateTime?
  claveResetToken       String?  // token temporal para resetear desde un enlace
  claveResetExpira      DateTime?
  // === v4.13 — Cambio de clave obligatorio en el primer ingreso ===
  // Cuando el gestor crea el cliente, el sistema auto-genera una clave temporal,
  // la envía al correo del cliente y marca `debeCambiarClave=true`.
  // En el primer login exitoso, el portal debe forzar el cambio de clave antes
  // de permitir el acceso al panel. Tras el cambio, el flag se apaga.
  debeCambiarClave      Boolean  @default(false)
  claveTempToken        String?  // token de sesión temporal que autoriza únicamente el cambio de clave (no navegación)
  claveTempExpira       DateTime?
  // Tasa personalizada (si el cliente tiene una tasa especial acordada)
  tieneTasaPersonalizada Boolean @default(false)
  tasaPersonalizada      Float?  // % mensual fija aplicada sobre capital inicial
  // Sesión del portal (token + expiración persistidos para validar solicitudes web)
  tokenSesion     String?
  tokenExpira     DateTime?
  // === TOTP para chat interno del portal (reemplaza OTP WhatsApp) ===
  // Solo aplica al chat de comunicaciones internas. Los demás OTP (firma de pagaré,
  // código de aprobación de préstamo, MFA de admin, recuperación de clave) siguen intactos.
  totpSecret       String?   // secreto base32 (160 bits)
  totpEnabled      Boolean   @default(false)
  totpCreatedAt    DateTime?
  totpLastUsed     DateTime?
  // Referido por (otro cliente)
  referidoPorId   String?
  referidoPor     Cliente?  @relation("ClienteReferido", fields: [referidoPorId], references: [id])
  referidos       Cliente[] @relation("ClienteReferido")
  categoriaId     String?
  categoria       CategoriaCliente? @relation(fields: [categoriaId], references: [id])
  // === Cuenta de recaudo asignada al cliente ===
  // El cliente debe pagar ÚNICAMENTE a esta cuenta salvo instrucción explícita del gestor.
  // Si no se asigna, se usa la cuenta asociada a su categoría (categoría.cuentaRecaudoId).
  cuentaRecaudoId String?
  cuentaRecaudo   CuentaRecaudo? @relation("ClienteCuentaRecaudo", fields: [cuentaRecaudoId], references: [id])
  // === Instrucción de pago temporal (cuando el gestor cambia la cuenta para uno o más pagos) ===
  instruccionCuentaId   String?  // ID de cuenta temporal sobreescrita por el gestor
  instruccionCuentaNota String?  // explicación del cambio (ej: "Pago puntual a CTA-3 por cierre mes")
  instruccionCuentaExpira DateTime?
  // === Preferencia de notificación de pagos ===
  // Define cómo el cliente desea recibir recordatorios automáticos de cuotas próximas a vencer.
  // - WHATSAPP: solo WhatsApp al teléfono registrado
  // - EMAIL:    solo correo electrónico
  // - AMBOS:    WhatsApp + correo electrónico
  // - NINGUNO:  el cliente optó por no recibir recordatorios
  preferenciaNotificacion String? @default("WHATSAPP")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  prestamos       Prestamo[]
  campañasVistas  CampañaVista[]
  firmas          FirmaElectronica[]
  tokensFirma     TokenFirma[] @relation("ClienteTokenFirma")
  documentosGestor DocumentoGestor[] @relation("DocumentosCliente")
  accesosPortal   AccesoPortal[] @relation("ClienteAccesosPortal")
  solicitudesWeb  SolicitudWeb[]
  conversacionesChat ConversacionChat[]
  otpsChat        OtpChat[]
  otpRegistros    OtpRegistro[] @relation("ClienteOtpRegistro")
}

// -----------------------------------------------------
// CATEGORÍA DE CLIENTE (Admin)
// Define valores máximos y tasa por categoría (1-4)
// -----------------------------------------------------
model CategoriaCliente {
  id              String   @id @default(cuid())
  codigo          String   @unique  // CAT-1, CAT-2, CAT-3, CAT-4
  nombre          String
  montoMinimo     Float
  montoMaximo     Float
  tasaInteresAnual Float
  tasaMoraAnual   Float
  descripcion     String?
  activa          Boolean  @default(true)
  cuentaRecaudoId String?
  cuentaRecaudo   CuentaRecaudo? @relation(fields: [cuentaRecaudoId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  clientes        Cliente[]
  prestamos       Prestamo[]
}

// -----------------------------------------------------
// CUENTAS DE RECAUDO (Admin)
// 4 cuentas bancarias donde los clientes pagan según categoría
// -----------------------------------------------------
model CuentaRecaudo {
  id              String   @id @default(cuid())
  codigo          String   @unique  // CTA-1, CTA-2, CTA-3, CTA-4
  nombre          String
  banco           String
  tipoCuenta      String   // AHORROS | CORRIENTE
  numeroCuenta    String
  titular         String
  // === QR de la cuenta (imagen en base64) ===
  // Permite cargar una imagen QR para que los clientes puedan escanearla
  // desde el portal del cliente al momento de realizar pagos.
  // Se almacena como data URL (base64) para no depender de servicios externos.
  qrImagen        String?
  activa          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  categorias      CategoriaCliente[]
  clientes        Cliente[] @relation("ClienteCuentaRecaudo")
  pagos           Pago[]
}

// -----------------------------------------------------
// PRÉSTAMO
// Interés FIJO calculado sobre capital inicial (no varía)
// Mora compuesta diaria calculada sobre saldo de cuota vencida
// -----------------------------------------------------
model Prestamo {
  id                  String   @id @default(cuid())
  codigo              String   @unique
  clienteId           String
  cliente             Cliente  @relation(fields: [clienteId], references: [id])
  categoriaId         String?
  categoria           CategoriaCliente? @relation(fields: [categoriaId], references: [id])

  // Variables bancarias
  montoPrincipal      Float    // CAPITAL INICIAL (base fija para intereses)
  tasaInteresAnual    Float    // % anual asignable (fijo de inicio a fin)
  tasaInteresMensual  Float    @default(0) // % mensual calculado automáticamente
  tasaMoraDiaria      Float    // % moratorio DIARIO (ej: 1 = 1% diario)
  plazoMeses          Int
  frecuencia          String   // MENSUAL | QUINCENAL | SEMANAL
  numeroCuotas        Int
  montoCuota          Float    // cuota FIJA
  totalInteres        Float    // interés total calculado sobre capital inicial
  totalPagar          Float
  tasaAplicada        Float

  // Modalidad de amortización (controla si se muestra la tasa en WhatsApp)
  // FRANCES = sistema francés (cuota fija con interés sobre capital inicial)
  // OTRO    = otra modalidad (no se muestra la tasa en plantillas WhatsApp de aprobación)
  modalidadAmortizacion String @default("FRANCES")

  // Mora configurable
  tasaMoraPersonalizada Float?  // si el admin la modifica para este préstamo
  moraCompuestaDiaria Boolean @default(true)  // mora compuesta diaria
  montoMoraAcumulado  Float   @default(0)

  // === Mora renegociada / anulada (acuerdo con el cliente) ===
  // Si está seteada, reemplaza la mora calculada automáticamente en el módulo de pagos.
  // El gestor puede: ANULAR (fija en 0) o NEGOCIAR (fija en un valor acordado).
  moraRenegociada             Float?    // valor acordado que reemplaza la mora calculada
  moraRenegociadaAccion       String?   // ANULADA | NEGOCIADA
  moraRenegociadaFecha        DateTime?
  moraRenegociadaPorId        String?   // usuarioId que renegoció
  moraRenegociadaPorNombre    String?
  moraRenegociadaObservacion  String?   // explicación del acuerdo tomado con el cliente
  moraRenegociadaMoraOriginal Float?    // snapshot de la mora calculada al momento de renegociar

  // Fechas y estado
  fechaSolicitud      DateTime @default(now())
  fechaAprobacion     DateTime?
  fechaDesembolso     DateTime?
  fechaVencimiento    DateTime?
  estado              String   @default("SOLICITUD")
  // SOLICITUD | PENDIENTE_ACEPTACION | ACTIVO | EN_MORA | JURIDICO | CANCELADO | RECHAZADO

  // Aceptación T&C
  tycEnviado          Boolean  @default(false)
  tycAceptado         Boolean  @default(false)
  tycFechaAceptacion  DateTime?
  tycToken            String?  // token único para validar desde WhatsApp
  metodoConfirmacion  String?  // LINK | CORREO | WHATSAPP_API (método elegido por el gestor)

  // Documentos
  requiereDocumentos  Boolean  @default(true)
  generarPagare       Boolean  @default(true)
  generarCarta        Boolean  @default(true)
  docsDatosAdicionales String? // JSON con datos completos pagare/carta

  // Codeudor (respaldo del préstamo)
  tieneCodeudor       Boolean  @default(false)
  codeudorId          String?  // ID del cliente que es codeudor (de la matriz de clientes)
  codeudorNombre      String?
  codeudorCedula      String?
  codeudorTelefono    String?
  codeudorEmail       String?
  codeudorDireccion   String?
  codeudorFirmaId     String?  // ID de la firma electrónica del codeudor

  // Firma
  firmaId             String?  // referencia a firma electrónica

  // Saldo
  saldoCapital        Float    @default(0)
  saldoInteres        Float    @default(0)
  saldoTotal          Float    @default(0)
  cuotasPagadas       Int      @default(0)
  montoPagado         Float    @default(0)
  montoMora           Float    @default(0)
  diasMora            Int      @default(0)

  // Fondo de garantía (tasa configurable por gestor al crear el préstamo)
  fondoGarantiaCargado Boolean @default(false)
  fondoGarantiaMonto  Float    @default(0)
  fondoGarantiaTasa   Float    @default(0)  // Tasa aplicada (ej: 0.05 = 5%). 0 si no se cargó.

  // === Periodo de corte + días causados antes del corte ===
  // Permite registrar créditos solicitados ANTES de la fecha de corte.
  // Ej: cliente solicita el 2/08/2026, corte más cercano es el 5/08/2026,
  // el sistema cobra 3 días de interés anticipado y las cuotas se programan
  // desde el 5/08/2026 (fecha del corte), no desde el 2/08/2026.
  periodoCorte        String?  // "5-20" | "15-30" — días de corte del periodo
  diasCausadosAntes   Int?     // días entre fechaPrestamo y el corte más cercano
  valorDiasCausados   Float?   // monto COP a cobrar por esos días (interés anticipado)
  fechaPrimerCorte    DateTime? // fecha del primer corte (inicio real de pagos)

  // === Flexibilidad Financiera (beneficio opcional) ===
  // Se ofrece cuando el número de cuotas >= 4. DOS tarifas:
  //   - BASICA:  $15.000 COP — permite usar el beneficio 1 sola vez durante la vigencia
  //   - PREMIUM: $34.900 COP — permite usar el beneficio 2 veces durante la vigencia
  // Permite al cliente:
  //   1) Trasladar UNA cuota al final del crédito
  //   2) Solicitar cambio de fecha de pago (genera documento "Otro Sí")
  //
  // - flexibilidadFinanciera: si el beneficio quedó adquirido en la solicitud
  // - flexibilidadCosto: monto COP cobrado (15000 o 34900)
  // - flexibilidadModalidad: "BASICA" | "PREMIUM"
  // - flexibilidadUsosDisponibles: cuántos usos le quedan al cliente (1 o 2 al inicio)
  // - flexibilidadUsosEjercidos: cuántos usos ha consumido
  // - flexibilidadActivada: si el cliente ya exercised el derecho (pagó el costo)
  //   Solo cuando esto es true se pueden generar Otros Síes.
  // - flexibilidadCobroAplicado: si el cobro ya fue incluido en la primera cuota
  flexibilidadFinanciera     Boolean   @default(false)
  flexibilidadCosto          Float     @default(0)
  flexibilidadModalidad      String?   // BASICA | PREMIUM
  flexibilidadUsosDisponibles Int      @default(0)
  flexibilidadUsosEjercidos  Int       @default(0)
  flexibilidadActivada       Boolean   @default(false)
  flexibilidadFechaActivacion DateTime?
  flexibilidadCobroAplicado  Boolean   @default(false)
  // === Bitácora de usos de Flexibilidad Financiera (Tarea Q) ===
  // JSON array con el historial de usos. Cada entrada:
  //   { fechaUso, cuotaTrasladada, vencimientoOriginal, vencimientoNuevo,
  //     interesesCausados, modalidadUso, pagoId, usuarioNombre }
  // Sirve para auditoría y para mostrar el detalle en el estado de cuenta.
  flexibilidadMovimientos    String?   // JSON serializado

  // === Cobro de Pagaré + Carta de Instrucciones ===
  // Cargo fijo editable (por defecto $19.900 COP) que se cobra UNA sola vez
  // al cliente cuando el préstamo incluye generar pagare + carta de instrucciones.
  // Se explica en el estado de cuenta como concepto "Pagaré + Carta de Instrucciones".
  cobroPagareCarta    Boolean @default(false)
  valorPagareCarta    Float   @default(19900)  // editable por gestor

  // === Tarifa de Uso de Plataforma (Tarea U) ===
  // Cargo fijo editable (por defecto $4.900 COP) que se cobra UNA sola vez
  // al cliente por el uso de la plataforma tecnológica asociada al crédito.
  // Se refleja en el estado de cuenta como concepto "Tarifa de Uso de Plataforma".
  // El ingreso se registra automáticamente en la caja CAJA-USO-PLATAFORMA
  // cuando se aplica el cobro (al activarse el préstamo o al pagarse la 1ra cuota).
  cobroTarifaPlataforma Boolean @default(false)
  valorTarifaPlataforma Float   @default(4900)  // editable por gestor
  tarifaPlataformaCargada Boolean @default(false)  // true cuando ya se registró el ingreso en caja

  // === RENOVACIÓN DIFERIDA (Tarea T) ===
  // Cuando un préstamo se crea como renovación de otro, NO se cancela el crédito
  // anterior inmediatamente. Se guarda la referencia aquí y se cancela recién
  // cuando el cliente acepta los T&C del nuevo préstamo (firmar TyC).
  // - renovacionPendienteTyc: true mientras el crédito anterior sigue activo
  //   esperando que el cliente acepte los T&C del nuevo.
  // - renovacionPrestamoAnteriorId: ID del crédito anterior que será cancelado
  //   al aceptarse los T&C.
  // - renovacionFechaCancelacionAnterior: timestamp en que se canceló el
  //   anterior (auditoría / depuración).
  renovacionPendienteTyc           Boolean    @default(false)
  renovacionPrestamoAnteriorId     String?
  renovacionFechaCancelacionAnterior DateTime?

  notas               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  pagos               Pago[]
  pagosProgramados    PagoProgramado[]
  refinanciaciones    Refinanciacion[]
  casoJuridico        CasoJuridico?
  notificaciones      NotificacionLog[]
  documentos      DocumentoGestor[] @relation("DocumentosPrestamo")
  firmas              FirmaElectronica[]
  tokensFirma         TokenFirma[] @relation("PrestamoTokenFirma")
  movimientosCaja     MovimientoCaja[]
  otrosSi             OtroSiCambioFecha[]
}

// -----------------------------------------------------
// OTRO SÍ — Acuerdo de cambio de fechas durante la vigencia
// -----------------------------------------------------
// Documento adicional que se anexa al pagare y carta de instrucciones
// cuando el cliente con "Flexibilidad Financiera" activada solicita:
//   - Cambio de fecha de pago
//   - Trasladar una cuota al final del crédito
//
// NO modifica el pagare ni la carta originales. Se ve aparte y se exporta solo.
// Requiere firma electrónica con OTP al correo del cliente.
// -----------------------------------------------------
model OtroSiCambioFecha {
  id              String   @id @default(cuid())
  prestamoId      String
  prestamo        Prestamo @relation(fields: [prestamoId], references: [id])

  // Código consecutivo: OS-001, OS-002, etc.
  codigo          String

  // Tipo de modificación
  tipoModificacion String  // CAMBIO_FECHA | TRASLADO_CUOTA
  // CAMBIO_FECHA: cambia la fecha de pago de una o varias cuotas
  // TRASLADO_CUOTA: traslada una cuota al final del crédito

  // === Fechas: las que tenía iniciales → a las que se programan ===
  // Se guarda como JSON: [{ cuota: 3, fechaAnterior: "2026-08-05", fechaNueva: "2026-08-10" }, ...]
  fechasAnteriores  String  // JSON serializado: [{ cuota, fechaAnterior, fechaNueva }]
  fechasNuevas      String  // JSON serializado (alias para el mismo arreglo, para facilitar lectura)

  // === Descripción textual del cambio (para mostrar en el documento) ===
  descripcion     String

  // === Estado del Otro Sí ===
  estado          String   @default("PENDIENTE_FIRMA")
  // PENDIENTE_FIRMA | FIRMADO | ANULADO

  // === Firma electrónica (cuando el cliente firma con OTP) ===
  firmaId         String?  @unique
  firma           FirmaElectronica? @relation("OtroSiFirma", fields: [firmaId], references: [id])

  // === Auditoría ===
  solicitadoPor   String?  // nombre del usuario que lo generó
  fechaSolicitud  DateTime @default(now())
  fechaFirma      DateTime?
  fechaAnulacion  DateTime?
  motivoAnulacion String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([prestamoId, estado])
}

// -----------------------------------------------------
// PAGO
// -----------------------------------------------------
model Pago {
  id              String   @id @default(cuid())
  codigo          String?  // código único para link de pago
  prestamoId      String
  prestamo        Prestamo @relation(fields: [prestamoId], references: [id])
  numeroCuota     Int
  montoCapital    Float
  montoInteres    Float
  montoMora       Float    @default(0)
  montoTotal      Float
  fechaPago       DateTime?
  fechaVencimiento DateTime
  metodoPago      String   @default("EFECTIVO")
  referencia      String?
  cuentaRecaudoId String?
  cuentaRecaudo   CuentaRecaudo? @relation(fields: [cuentaRecaudoId], references: [id])
  estado          String   @default("PENDIENTE")
  // PENDIENTE | APLICADO | ANULADO | REVERSADO | VENCIDO | PAGO_PARCIAL
  linkPago        String?
  linkExpira      DateTime?
  notas           String?

  // === Modo "Solo Intereses" (v4.0) ===
  // Cuando el cliente solo abona intereses, el capital de esa cuota
  // se difiere (no se paga ahora), la cuota "se corre" a la siguiente
  // fecha de vencimiento, y no se genera mora sobre esa cuota.
  esSoloIntereses Boolean  @default(false)
  cuotaAplazadaDe Int?     // si este pago aplazó una cuota, indica cuál (snapshot)
  fechaOriginalVencimiento DateTime? // vencimiento original antes del aplazamiento

  // === Uso de Flexibilidad Financiera (v4.0 — Tarea Q) ===
  // Cuando el cliente ejerce el beneficio de Flexibilidad Financiera
  // (que pagó al inicio del crédito: 15.000 = 1 uso o 34.900 = 2 usos),
  // la cuota pendiente actual se TRASLADA al final del crédito junto
  // con los intereses ya causados, evitando generación de mora.
  // Este registro NO es un pago en dinero (montoTotal=0), es un asiento
  // contable que documenta el uso del beneficio.
  // Diferencia con "Solo Intereses":
  //   - Solo Intereses: cliente paga los intereses, capital se difiere 1 periodo
  //   - Flexibilidad Financiera: NO hay pago, la cuota completa se va al final
  esFlexibilidadFinanciera Boolean @default(false)
  cuotaMovidaAlFinal      Boolean @default(false)  // true si este "pago" trasladó una cuota al final
  cuotaTrasladadaNumero   Int?     // número de la cuota que se trasladó
  fechaVencimientoOriginalTraslado DateTime? // vencimiento original antes del traslado
  fechaVencimientoNuevoTraslado    DateTime? // nuevo vencimiento al final del crédito
  interesesCausadosAlTraslado      Float    @default(0) // intereses moratorios ya causados al momento del traslado
  flexibilidadModalidadUso String? // BASICA | PREMIUM (snapshot de la modalidad del préstamo al momento del uso)

  // === Anulación (soft-delete v4.0) ===
  // El hard-delete quedó deprecado. Anular marca estado='ANULADO' y conserva el registro.
  motivoAnulacion String?
  anuladoPorId    String?
  anuladoPor      Usuario? @relation("PagoAnuladoPor", fields: [anuladoPorId], references: [id])
  fechaAnulacion  DateTime?

  // Reversión
  reversadoPorId  String?
  reversadoPor    Usuario? @relation(fields: [reversadoPorId], references: [id])
  fechaReversion  DateTime?
  motivoReversion String?

  // === Comprobante de pago (v4.0) ===
  // El cliente puede subir foto/scan de la transferencia.
  comprobanteUrl  String?
  comprobanteHash String?
  comprobanteValidado Boolean @default(false)
  comprobanteValidadoPorId String?
  comprobanteFechaValidacion DateTime?

  // === Recibo digital firmado (v4.0) ===
  reciboHash      String?  // SHA-256 del contenido del recibo (verificación pública)
  reciboFechaEmision DateTime?

  // === Recordatorio automático de pago (v4.4) ===
  // Fecha del último recordatorio automático enviado al cliente por el cron diario.
  // Se marca para evitar enviar múltiples recordatorios por la misma cuota.
  // El cron consulta los Pago con fechaVencimiento entre hoy y mañana, y envía
  // el recordatorio solo si recordatorioEnviadoEn es null o es de un día anterior.
  recordatorioEnviadoEn DateTime?
  recordatorioMedios    String?  // "WHATSAPP", "EMAIL", "AMBOS" — qué medios se usaron

  createdAt       DateTime @default(now())

  @@index([estado, fechaPago])
  @@index([prestamoId, numeroCuota])
  @@index([esSoloIntereses])
  @@index([esFlexibilidadFinanciera])
  @@index([fechaVencimiento, estado])
}

// -----------------------------------------------------
// PAGO PROGRAMADO (v4.0 — OLA 3)
// Materialización de la tabla de amortización.
// Cron nocturno regenera esta tabla para escalar consultas
// de "próximos pagos" sin recalcular en cada request.
// -----------------------------------------------------
model PagoProgramado {
  id              String   @id @default(cuid())
  prestamoId      String
  prestamo        Prestamo @relation(fields: [prestamoId], references: [id])
  numeroCuota     Int
  fechaVencimiento DateTime
  montoCapital    Float
  montoInteres    Float
  montoCuota      Float
  saldoCapitalDespues Float
  // Estado calculado del cron
  estado          String   @default("PROGRAMADO")
  // PROGRAMADO | PAGADO | PARCIAL | VENCIDO | APLAZADO
  montoPagado     Float    @default(0)
  moraCalculada  Float    @default(0)  // snapshot de mora al momento del cron
  diasMora       Int      @default(0)
  fechaUltimaActualizacion DateTime @default(now())
  // Aplazamiento por "solo intereses"
  fechaOriginalVencimiento DateTime?
  aplazado       Boolean  @default(false)

  @@unique([prestamoId, numeroCuota])
  @@index([fechaVencimiento, estado])
  @@index([prestamoId, estado])
}

// -----------------------------------------------------
// REFINANCIACIÓN (v4.0 — OLA 3)
// Acuerdo de refinanciación: genera nueva tabla de amortización
// a partir del saldo pendiente, opcionalmente capitalizando mora.
// -----------------------------------------------------
model Refinanciacion {
  id              String   @id @default(cuid())
  prestamoId      String
  prestamo        Prestamo @relation(fields: [prestamoId], references: [id])
  tipo            String   // REFINANCIACION | REESTRUCTURACION | ACUERDO_PAGO
  estado          String   @default("PENDIENTE")
  // PENDIENTE | ACEPTADA | RECHAZADA | FIRMADA | ANULADA

  // Snapshot del préstamo al momento de la refinanciación
  saldoCapitalAntes   Float
  saldoInteresAntes   Float
  moraAntes           Float
  totalAntes          Float

  // Nueva propuesta
  nuevoMontoPrincipal Float  // saldo + mora capitalizada (si aplica)
  nuevaTasaInteresAnual Float
  nuevoPlazoMeses     Int
  nuevaFrecuencia     String
  nuevasCuotas        Int
  nuevoMontoCuota     Float

  // Capitalización
  capitalizaMora      Boolean @default(false)
  capitalizaInteres   Boolean @default(false)

  // Auditoría
  solicitadoPorId     String?
  aprobadoPorId       String?
  fechaSolicitud      DateTime @default(now())
  fechaAprobacion     DateTime?
  fechaFirma          DateTime?
  observaciones       String?

  // Firma
  firmaId             String?

  // Nueva tabla de amortización (JSON serializado)
  nuevaTablaAmortizacion String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([prestamoId, estado])
}


// -----------------------------------------------------
// CASO JURÍDICO
// Reforzado: documentación paso a paso + exportación Word/PDF
// -----------------------------------------------------
model CasoJuridico {
  id              String   @id @default(cuid())
  prestamoId      String   @unique
  prestamo        Prestamo @relation(fields: [prestamoId], references: [id])

  estado          String   @default("PRE_JUDICIAL")
  // PRE_JUDICIAL | DEMANDA | EJECUCION | COBRO_JUDICIAL | CONCILIACION | SENTENCIA | CERRADO

  abogadoNombre   String?
  abogadoTelefono String?
  abogadoEmail    String?
  abogadoAsignado Boolean @default(false)
  honorarios      Float    @default(0)
  honorariosPagados Float @default(0)

  juzgado         String?
  radicado        String?
  tipoProceso     String? // EJECUTIVO | VERBAL | EJECUTIVO_HIPOTECARIO
  valorReclamado  Float?
  fechaPresentacionDemanda DateTime?
  fechaAdmision   DateTime?
  fechaEmbargo    DateTime?
  fechaAudiencia  DateTime?
  descripcion     String?
  fechaApertura   DateTime @default(now())
  fechaCierre     DateTime?
  resultadoFinal  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  cronologias     CronologiaCaso[]
  documentos      DocumentoLegal[]
  alertas         AlertaLegal[]
}

// -----------------------------------------------------
// CRONOLOGÍA DEL CASO (reforzada - paso a paso)
// -----------------------------------------------------
model CronologiaCaso {
  id              String   @id @default(cuid())
  casoId          String
  caso            CasoJuridico @relation(fields: [casoId], references: [id])
  fecha           DateTime @default(now())
  tipoEvento      String
  // AUDIENCIA | ESCRITO | RESOLUCION | NOTIFICACION | REUNION | PAGO | EMBARGO | OTRO
  titulo          String
  descripcion     String?
  resultado       String?
  actor           String?  // quien hizo la acción
  documentoAnexo  String?  // nombre de archivo si se adjuntó
  monto           Float?   // si aplica (honorarios, pagos parciales)
  createdAt       DateTime @default(now())
}

// -----------------------------------------------------
// DOCUMENTOS LEGALES
// -----------------------------------------------------
model DocumentoLegal {
  id              String   @id @default(cuid())
  casoId          String
  caso            CasoJuridico @relation(fields: [casoId], references: [id])
  tipo            String
  // CONTRATO | PAGARE | DEMANDA | NOTIFICACION | ANEXO | SENTENCIA | ACUERDO_PAGO | OTRO
  nombre          String
  descripcion     String?
  contenido       String?
  fechaSubida     DateTime @default(now())
}

// -----------------------------------------------------
// ALERTAS LEGALES
// -----------------------------------------------------
model AlertaLegal {
  id              String   @id @default(cuid())
  casoId          String
  caso            CasoJuridico @relation(fields: [casoId], references: [id])
  fechaAlerta     DateTime
  tipo            String
  descripcion     String
  atendida        Boolean  @default(false)
  fechaAtencion   DateTime?
  createdAt       DateTime @default(now())
}

// -----------------------------------------------------
// CAJAS MENORES - Contabilidad de ingresos/egresos
// -----------------------------------------------------
model CajaMenor {
  id              String   @id @default(cuid())
  codigo          String   @unique  // CAJA-MORA | CAJA-GARANTIA | CAJA-FLEXIBILIDAD | CAJA-INGRESOS-CAUSADOS | CAJA-PAGARE-CARTA | CAJA-USO-PLATAFORMA
  nombre          String
  descripcion     String?
  saldoActual     Float    @default(0)
  totalIngresos   Float    @default(0)
  totalEgresos    Float    @default(0)
  activa          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  movimientos     MovimientoCaja[]
}

// -----------------------------------------------------
// MOVIMIENTOS DE CAJA (ingresos y egresos)
// -----------------------------------------------------
model MovimientoCaja {
  id              String   @id @default(cuid())
  cajaId          String
  caja            CajaMenor @relation(fields: [cajaId], references: [id])
  tipo            String   // INGRESO | EGRESO
  monto           Float
  concepto        String
  referencia      String?  // código del préstamo, pago, etc.
  prestamoId      String?
  fechaMovimiento DateTime @default(now())
  creadoPor       String?
  ambito          String   @default("NEGOCIO") // NEGOCIO | PERSONAL
  usuarioId       String?
  usuario         Usuario? @relation(fields: [usuarioId], references: [id])
  prestamo        Prestamo? @relation(fields: [prestamoId], references: [id])
  createdAt       DateTime @default(now())
  movimientoCajaExtendido MovimientoCajaExtendido?

  @@index([ambito, fechaMovimiento])
  @@index([tipo])
}

// -----------------------------------------------------
// FIRMA ELECTRÓNICA - dibujada + OTP
// -----------------------------------------------------
model FirmaElectronica {
  id              String   @id @default(cuid())
  prestamoId      String?
  prestamo        Prestamo? @relation(fields: [prestamoId], references: [id])
  clienteId       String?
  cliente         Cliente?  @relation(fields: [clienteId], references: [id])
  tipo            String   // PAGARE | CONTRATO | ACUERDO_PAGO | TYC
  imagenFirma     String   // base64 de la firma dibujada
  otpEnviado      Boolean  @default(false)
  otpValidado     Boolean  @default(false)
  otpCodigo       String?
  otpCanal        String?  // WHATSAPP | EMAIL | AMBOS
  otpFechaEnvio   DateTime?
  otpFechaValidacion DateTime?
  documentoFirmado String? // base64 del PDF firmado

  // === Verificación de identidad con fotos ===
  fotoDocumento   String?  // base64 foto del documento de identidad (frente)
  fotoSelfie      String?  // base64 foto selfie sosteniendo la cédula
  fotoDocumentoHash String? // hash SHA-256 de la foto del documento
  fotoSelfieHash  String?  // hash SHA-256 del selfie
  ipFirma         String?  // IP desde donde se firmó
  userAgent       String?  // navegador/dispositivo usado
  geoUbicacion    String?  // coordenadas GPS si están disponibles (JSON)
  fechaSubidaFotos DateTime?
  fechaFirmaCompleta DateTime?

  // Estado del proceso de firma
  estadoFirma     String   @default("PENDIENTE") // PENDIENTE | FOTOS_SUBIDAS | FIRMA_DIBUJADA | OTP_ENVIADO | COMPLETADA | RECHAZADA | EXPIRADA
  intentosOTP     Int      @default(0)
  maxIntentos     Int      @default(5)

  // === Firma de codeudor (si aplica) ===
  esFirmaCodeudor Boolean  @default(false) // true = esta firma es del codeudor
  firmanteRol     String?  // DEUDOR | CODEUDOR
  firmanteNombre  String?  // nombre de quien firma
  firmanteCedula  String?  // cédula de quien firma

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tokens          TokenFirma[]
  otroSi          OtroSiCambioFecha? @relation("OtroSiFirma")
}

// -----------------------------------------------------
// TOKEN DE FIRMA PÚBLICA (acceso sin login)
// Permite al cliente firmar desde un link seguro
// -----------------------------------------------------
model TokenFirma {
  id              String   @id @default(cuid())
  token           String   @unique
  firmaId         String
  firma           FirmaElectronica @relation(fields: [firmaId], references: [id])
  prestamoId      String?
  prestamo        Prestamo? @relation("PrestamoTokenFirma", fields: [prestamoId], references: [id])
  clienteId       String?
  cliente         Cliente?  @relation("ClienteTokenFirma", fields: [clienteId], references: [id])
  usado           Boolean  @default(false)
  fechaExpiracion DateTime
  fechaUsado      DateTime?
  createdAt       DateTime @default(now())
}

// -----------------------------------------------------
// NOTIFICACIONES WHATSAPP
// -----------------------------------------------------
model NotificacionLog {
  id              String   @id @default(cuid())
  prestamoId      String?
  prestamo        Prestamo? @relation(fields: [prestamoId], references: [id])
  clienteTelefono String
  tipo            String
  // SOLICITUD | APROBACION | PAGO | CANCELACION | RECORDATORIO | MORA | LEGAL | TYC | OTP | CAMPANA
  mensaje         String
  estado          String   @default("PENDIENTE")
  // PENDIENTE | ENVIADO | FALLIDO | PENDIENTE_MANUAL
  error           String?
  linkWaMe        String?  // enlace wa.me para envío manual
  // v4.12 (QA M09 TC-NOT-003): wamid devuelto por WhatsApp Cloud API de Meta
  wamid           String?  // WhatsApp Message ID (cuando se envía vía Cloud API)
  // v4.12 (QA M09 TC-NOT-014): canal usado para el envío
  canal           String?  // WHATSAPP | EMAIL | WA_ME_LINK
  fechaEnvio      DateTime @default(now())
}

// -----------------------------------------------------
// CAMPAÑAS (publicadas para clientes)
// -----------------------------------------------------
model Campaña {
  id              String   @id @default(cuid())
  titulo          String
  descripcion     String
  contenido       String?  // HTML o texto enriquecido
  imagenUrl       String?
  tipo            String   // PROMOCION | INFORMATIVO | RECORDATORIO | OFERTA
  fechaInicio     DateTime @default(now())
  fechaFin        DateTime?
  activa          Boolean  @default(true)
  destinatarios   String   @default("TODOS") // TODOS | CATEGORIA-1 | CATEGORIA-2...
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vistas          CampañaVista[]
}

model CampañaVista {
  id              String   @id @default(cuid())
  campañaId       String
  campaña         Campaña  @relation(fields: [campañaId], references: [id])
  clienteId       String?
  cliente         Cliente? @relation(fields: [clienteId], references: [id])
  fechaVista      DateTime @default(now())
}

// -----------------------------------------------------
// CONFIGURACIÓN DEL SISTEMA (Control General)
// -----------------------------------------------------
model Configuracion {
  id              String   @id @default(cuid())
  clave           String   @unique
  valor           String
  descripcion     String?
  updatedAt       DateTime @updatedAt
}

// -----------------------------------------------------
// BITÁCORA DE PRÉSTAMO (trazabilidad por código de préstamo)
// Se puede usar desde la sección Jurídica o desde el detalle del préstamo
// -----------------------------------------------------
model BitacoraPrestamo {
  id              String   @id @default(cuid())
  prestamoId      String
  prestamoCodigo  String   // código del préstamo para trazabilidad
  usuarioId       String?
  usuario         Usuario? @relation(fields: [usuarioId], references: [id])
  usuarioNombre   String   // nombre del usuario que registra (snapshot)
  tipo            String   // NOTA | LLAMADA | VISITA | EMAIL | WHATSAPP | REUNION | PAGO | JURIDICO | OTRO
  titulo          String
  descripcion     String
  resultado       String?
  fechaEvento     DateTime @default(now())
  createdAt       DateTime @default(now())
}

// -----------------------------------------------------
// AUDIT LOG - Registro inmutable de todas las acciones sensibles
// Append-only: nunca se borra, nunca se edita
// -----------------------------------------------------
model AuditLog {
  id              String   @id @default(cuid())
  usuarioId       String?
  usuario         Usuario? @relation(fields: [usuarioId], references: [id])
  usuarioNombre   String   // snapshot del nombre
  accion          String   // LOGIN | LOGOUT | CREATE | UPDATE | DELETE | REVERSAR | ELIMINAR | APROBAR | etc.
  modulo          String   // clientes | prestamos | pagos | juridico | cajas | usuarios | etc.
  entidadId       String?  // ID de la entidad afectada
  entidadNombre   String?  // nombre/descripción de la entidad
  detalles        String?  // JSON con cambios detalles
  ipOrigen        String?  // IP desde donde se hizo la acción
  userAgent       String?  // navegador/dispositivo
  exito           Boolean  @default(true)
  errorMessage    String?
  fecha           DateTime @default(now())
}

// -----------------------------------------------------
// CÓDIGO DE CONFIRMACIÓN POR CORREO
// Reemplaza el link de WhatsApp por un código que el cliente
// recibe en su email y debe compartir con el gestor para aprobar
// -----------------------------------------------------
model CodigoConfirmacion {
  id              String   @id @default(cuid())
  prestamoId      String
  // Rol del destinatario del código:
  //   'DEUDOR'     → obligatorio, siempre se genera uno para el titular del préstamo.
  //   'CODEUDOR'   → se genera adicionalmente solo si prestamo.tieneCodeudor=true.
  // Cuando el préstamo NO tiene codeudor, basta con verificar el rol 'DEUDOR'
  // para activarlo. Cuando SÍ tiene codeudor, AMBOS roles deben verificarse
  // antes de que el sistema pueda aprobar/activar el préstamo.
  rol             String   @default("DEUDOR")
  codigo          String   // código alfanumérico de 6 caracteres
  emailCliente    String   // email al que se envió
  usado           Boolean  @default(false)
  verificado      Boolean  @default(false)
  fechaGeneracion DateTime @default(now())
  fechaExpiracion DateTime
  fechaVerificacion DateTime?
  intentos        Int      @default(0)
  createdAt       DateTime @default(now())

  // Solo puede existir un código activo por (préstamo + rol).
  @@unique([prestamoId, rol])
}

// -----------------------------------------------------
// CONEXIONES DE API EXTERNAS
// -----------------------------------------------------
model ConexionAPI {
  id              String   @id @default(cuid())
  nombre          String
  tipo            String   // WHATSAPP_BUSINESS | TWILIO | EMAIL_SMTP | BANCOLOMBIA | BANCOLOMBIA_BOTON_PAGO | DAVIVIENDA | PSE | WEBHOOK | OTRO
  descripcion     String?
  url             String?
  apiKey          String?
  apiSecret       String?
  usuario         String?
  password        String?
  accountId       String?
  telefonoOrigen String?
  configuracionExtra String?
  activa          Boolean  @default(false)
  probada         Boolean  @default(false)
  fechaUltimaPrueba DateTime?
  resultadoUltimaPrueba String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// -----------------------------------------------------
// AUTOMATIZACIONES v3.0
// Tareas programadas y reglas automáticas del sistema
// -----------------------------------------------------
model Automatizacion {
  id              String   @id @default(cuid())
  nombre          String
  descripcion     String?
  tipo            String   // RECORDATORIO_PAGO | ESCALACION_MORA | COBRO_AUTOMATICO | WHATSAPP_AUTO | REPORTES_PROGRAMADOS | SINCRONIZACION_BANCARIA
  modulo          String   @default("general") // pagos | prestamos | juridico | clientes | general
  condicion       String?  // JSON con la condición (ej: diasMora > 5)
  accion          String?  // JSON con la acción a ejecutar
  activa          Boolean  @default(true)
  intervaloMinutos Int     @default(60)
  ultimaEjecucion DateTime?
  proximaEjecucion DateTime?
  ejecucionesTotales Int   @default(0)
  ejecucionesExitosas Int  @default(0)
  ejecucionesFallidas Int  @default(0)
  creadorId       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ejecuciones     EjecucionAutomatizacion[]
}

model EjecucionAutomatizacion {
  id              String   @id @default(cuid())
  automatizacionId String
  automatizacion  Automatizacion @relation(fields: [automatizacionId], references: [id], onDelete: Cascade)
  fechaInicio     DateTime @default(now())
  fechaFin        DateTime?
  estado          String   @default("PENDIENTE") // PENDIENTE | EJECUTANDO | COMPLETADA | FALLIDA
  resultado       String?
  error           String?
  entidadesAfectadas Int   @default(0)
  metadata        String?
  createdAt       DateTime @default(now())
}

// -----------------------------------------------------
// VERSIONES DEL SISTEMA v3.0
// Permite cambiar entre versiones del sistema (configuración/esquema)
// -----------------------------------------------------
model VersionSistema {
  id              String   @id @default(cuid())
  numero          String   @unique  // ej: 3.0.0
  nombre          String
  descripcion     String?
  cambios         String?  // JSON con changelog
  tipo            String   @default("MAYOR") // MAYOR | MENOR | PATCH | HOTFIX | RESTAURACION
  activa          Boolean  @default(false)
  creadorId       String?
  fechaActivacion DateTime?
  backupId        String?  // backup generado antes de activar
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// -----------------------------------------------------
// BACKUPS v3.0
// Backups manuales / automáticos / pre-activación de versión
// -----------------------------------------------------
model Backup {
  id              String   @id @default(cuid())
  nombre          String
  tipo            String   @default("MANUAL") // MANUAL | AUTOMATICO | PRE_ACTIVACION
  tamano          Int      @default(0)  // bytes
  rutaArchivo     String   // ruta relativa en /backups
  checksum        String?  // SHA-256
  entidadTipo     String?  // TODOS | SOLO_CLIENTES | SOLO_PRESTAMOS...
  estado          String   @default("COMPLETADO") // COMPLETADO | FALLIDO | RESTAURADO
  generadoPor     String?
  restauradoEn    DateTime?
  metadata        String?  // JSON con info detallada
  createdAt       DateTime @default(now())
}

// -----------------------------------------------------
// ACCESO PORTAL v3.0
// Trazabilidad de accesos al portal del cliente
// -----------------------------------------------------
model AccesoPortal {
  id              String   @id @default(cuid())
  clienteId       String?
  cliente         Cliente?  @relation("ClienteAccesosPortal", fields: [clienteId], references: [id])
  clienteCedula   String?
  clienteNombre   String?
  ipOrigen        String?
  userAgent       String?
  accion          String   // LOGIN | CONSULTA | INTENTO_FALLIDO | LOGOUT | CAMBIO_PIN | VERIFICAR_CEDULA
  exito           Boolean  @default(true)
  detalle         String?
  metadata        String?  // JSON con info adicional
  createdAt       DateTime @default(now())
}

// -----------------------------------------------------
// SEGURIDAD DE MÓDULOS
// -----------------------------------------------------
model SeguridadModulo {
  id              String   @id @default(cuid())
  moduloKey       String   @unique
  moduloNombre    String
  protegido       Boolean  @default(false)
  claveHash       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// -----------------------------------------------------
// SINCRONIZACIÓN DE PLATAFORMAS (GitHub / Vercel / Neon)
// Permite activar/desactivar sincronización en tiempo real
// desde el Módulo de Seguridad.
// -----------------------------------------------------
model PlataformaSync {
  id                String   @id @default(cuid())
  plataforma        String   @unique               // "GITHUB" | "VERCEL" | "NEON"
  nombreMostrar     String                          // "GitHub" | "Vercel" | "Neon Database"
  descripcion       String?
  // Estado de sincronización
  sincronizado      Boolean  @default(false)        // toggle principal: ON/OFF
  tiempoReal        Boolean  @default(false)        // sincronización en tiempo real (webhooks)
  // Configuración de conexión
  endpoint          String?                          // URL base de la API de la plataforma
  proyectoRef       String?                          // owner/repo (GitHub), project-id (Vercel), project-id (Neon)
  region            String?                          // región del recurso (Neon/Vercel)
  ramaPrincipal     String?  @default("main")        // rama GitHub a sincronizar
  // Credenciales cifradas (PAT / API Token) — almacenados cifrados con API_ENCRYPTION_KEY
  tokenCifrado      String?
  webhookSecret     String?                          // secreto compartido para validar webhooks entrantes
  webhookUrl        String?                          // URL pública que recibirá eventos de la plataforma
  // Estado y diagnóstico
  ultimoSync        DateTime?
