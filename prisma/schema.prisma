// -----------------------------------------------------
// PLAN ESTRATÉGICO FINANCIERO (Contabilidad)
// Planificación de estrategias con propósito financiero
// -----------------------------------------------------
model PlanEstrategicoFinanciero {
  id              String   @id @default(cuid())
  codigo          String   @unique
  nombre          String
  descripcion     String?
  tipo            String   @default("CRECIMIENTO") // CRECIMIENTO | OPTIMIZACION | REDUCCION_RIESGO | LIQUIDEZ | EXPANSION
  estado          String   @default("BORRADOR") // BORRADOR | ACTIVO | EN_REVISION | COMPLETADO | CANCELADO
  prioridad       String   @default("MEDIA") // BAJA | MEDIA | ALTA | CRITICA

  // Fechas del plan
  fechaInicio     DateTime
  fechaFin        DateTime
  fechaAprobacion DateTime?

  // Métricas financieras (COP)
  presupuestoInversion  Float  @default(0)
  metaIngresos          Float  @default(0)
  metaAhorroCostos      Float  @default(0)
  roiEsperado           Float  @default(0) // %

  // Métricas reales (se actualizan con reportes)
  ingresoReal           Float  @default(0)
  costoReal             Float  @default(0)
  roiReal               Float  @default(0)

  // Responsables
  responsableId         String?
  responsableNombre     String?
  creadoPor             String?
  aprobadoPor           String?

  // KPIs y seguimiento
  progreso              Float  @default(0) // 0-100
  indicadores           String? // JSON con KPIs personalizados
  notasSeguimiento      String?

  // Vinculación con reportes
  reporteVinculadoId    String?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([estado])
  @@index([tipo])
  @@index([fechaInicio])
}

// -----------------------------------------------------
// PLAN CLIENTE (Préstamos)
// Planificación de planes personalizados para clientes
// -----------------------------------------------------
model PlanCliente {
  id              String   @id @default(cuid())
  codigo          String   @unique
  clienteId       String
  clienteCedula   String
  clienteNombre   String

  nombre          String
  descripcion     String?
  tipo            String   @default("PERSONALIZADO") // PERSONALIZADO | REESTRUCTURACION | REFINANCIACION | EXPANSION_CREDITO | FIDELIZACION
  estado          String   @default("BORRADOR") // BORRADOR | PROPUESTO | ACEPTADO | EN_EJECUCION | COMPLETADO | CANCELADO

  // Fechas
  fechaInicio     DateTime
  fechaFin        DateTime
  fechaAceptacion DateTime?

  // Configuración financiera del plan
  montoObjetivo       Float  @default(0)
  tasaPersonalizada   Float?  // tasa mensual fija si aplica
  plazoMeses          Int    @default(12)
  cuotaObjetivo        Float  @default(0)

  // Métricas reales
  montoAprobado       Float  @default(0)
  cuotaActual         Float  @default(0)
  pagosRealizados     Int    @default(0)
  saldoPendiente      Float  @default(0)

  // Objetivos comerciales
  objetivoComercial   String? // ej: "Aumentar línea de crédito 30%"
  metricasExito       String? // JSON con métricas de éxito
  progreso            Float  @default(0) // 0-100

  // Vinculación con préstamos
  prestamoVinculadoId String?

  // Responsables
  gestorAsignado      String?
  creadoPor           String?
  notasSeguimiento    String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([clienteId])
  @@index([estado])
  @@index([tipo])
}

// -----------------------------------------------------
// CONTROL DE VERSIONES Y SNAPSHOTS DEL PROYECTO
// Snapshots completos del código fuente para recuperación
// -----------------------------------------------------
model SnapshotProyecto {
  id               String   @id @default(cuid())
  uuid             String   @unique  // UUID v4 único
  version          String   // ej: 1.0.25
  nombre           String
  descripcion      String?
  estado           String   @default("COMPLETADO") // COMPLETADO | FALLIDO | RESTAURADO
  tamano           Int      @default(0)  // bytes del archivo
  rutaArchivo      String   // ruta relativa en download/snapshots/
  checksum         String?  // SHA-256 del archivo
  archivosTotal    Int      @default(0)  // número de archivos capturados
  modulosAfectados String?  // JSON con lista de módulos
  tipo             String   @default("MANUAL") // MANUAL | AUTO_PRE_CAMBIO | AUTO_PRE_REFACTOR
  usuarioId        String?
  usuarioNombre    String?
  motivo           String?  // motivo del snapshot
  metadata         String?  // JSON con info detallada
  createdAt        DateTime @default(now())

  @@index([tipo])
  @@index([createdAt])
}

// -----------------------------------------------------
// SOLICITUD DE NUEVOS CLIENTES (desde el portal público)
// Persona que quiere iniciar el proceso de crédito
// -----------------------------------------------------
model SolicitudNuevoCliente {
  id                String   @id @default(cuid())
  codigo            String   @unique
  
  // Datos personales
  nombre            String
  apellido          String
  tipoDocumento     String   @default("CC") // CC | CE | TI
  cedula            String
  fechaNacimiento   DateTime?
  telefono          String
  email             String?
  ciudad            String?
  municipio         String?
  direccion         String?
  
  // Datos financieros
  ocupacion         String?
  ingresoMensual    Float?
  valorSolicitado   Float
  plazoDeseado      Int?     // meses
  destinoCredito    String?  // para qué necesita el crédito
  
  // Referido
  referidoPorNombre String?
  referidoPorApellido String?
  referidoPorTelefono String?
  referidoPorParentesco String? // parentesco o relación
  
  // Aceptaciones
  aceptaTyC         Boolean  @default(false)
  aceptaTratamientoDatos Boolean @default(false)
  aceptaConsultaCentrales  Boolean @default(false)
  aceptaReportarCentral    Boolean @default(false)
  fechaAceptacion    DateTime?

  // Documentos (fotos en base64 data URL)
  fotoCedulaFrente       String?  // data:image/jpeg;base64,...
  fotoCedulaReverso      String?
  fotoSelfie             String?  // selfie sosteniendo la cédula
  fotoCedulaFrenteNombre String?
  fotoCedulaReversoNombre String?
  fotoSelfieNombre       String?

  // Estado
  estado            String   @default("PENDIENTE") // PENDIENTE | REVISADA | APROBADA | RECHAZADA | CONVERTIDA
  observaciones     String?
  revisadoPorId     String?
  revisadoPorNombre String?
  fechaRevision     DateTime?
  clienteCreadoId   String?  // id del Cliente creado al convertir
  clienteCreadoCodigo String? // código generado

  // Trazabilidad
  ipOrigen          String?
  userAgent         String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([estado])
  @@index([cedula])
  @@index([email])
}

// -----------------------------------------------------
// REGISTRO CENTRALIZADO DE OTPs DE CLIENTES
// Consolida todos los códigos OTP generados para un cliente
// (firma electrónica, chat, portal, login, etc.)
// -----------------------------------------------------
model OtpRegistro {
  id              String   @id @default(cuid())
  clienteId       String?
  cliente         Cliente? @relation("ClienteOtpRegistro", fields: [clienteId], references: [id])
  clienteCedula   String?
  clienteNombre   String?
  
  codigoHash      String   // hash SHA-256 del código OTP (no el código en claro)
  codigoPlano     String?  // sólo en desarrollo/auditoría interna (NUNCA exponer en producción)
  metodo          String   // WHATSAPP | EMAIL | AMBOS | SMS
  destinatario    String   // número de teléfono o email al que se envió
  tipo            String   // FIRMA_ELECTRONICA | CHAT | PORTAL_LOGIN | CAMBIO_CLAVE | OTRO
  entidadRefId    String?  // ID de la entidad relacionada (firmaId, conversacionId, etc.)
  descripcion     String?
  
  intentos        Int      @default(0)
  maxIntentos     Int      @default(3)
  usado           Boolean  @default(false)
  bloqueado       Boolean  @default(false)
  fechaBloqueo    DateTime?
  expiraEn        DateTime
  ipSolicitud     String?
  userAgent       String?
  fechaVerificacion DateTime?
  verificado      Boolean  @default(false)
  sessionIdGenerado String?
  
  createdAt       DateTime @default(now())
  
  @@index([clienteId])
  @@index([tipo])
  @@index([createdAt])
}

// =====================================================
