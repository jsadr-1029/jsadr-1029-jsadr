// =====================================================
// FaqBot — Preguntas frecuentes del bot de clientes
// =====================================================
model FaqBot {
  id          String   @id @default(cuid())
  pregunta    String   // texto de la pregunta (ej: "¿Cómo solicito un préstamo?")
  respuesta   String   // respuesta que el bot debe dar
  categoria   String?  // ej: "PRESTAMOS", "PAGOS", "REQUISITOS"
  palabrasClave String? // ej: "solicitar,credito,requisitos" (separadas por coma)
  activa      Boolean  @default(true)
  vecesUsada  Int      @default(0)
  creadaPor   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([activa])
  @@index([categoria])
}

// =====================================================
// ConfigBot — Configuración del bot de clientes
// (interruptor ON/OFF del modo automático, etc.)
// =====================================================
model ConfigBot {
  id          String   @id @default(cuid())
  clave       String   @unique // ej: "asistente_ia_automatico", "horario_atencion"
  valor       String   // ej: "true", "false", "08:00-18:00"
  descripcion String?
  actualizadoPor String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// =====================================================
// CategoriaFinanciera — Categorías para clasificar movimientos
// =====================================================
model CategoriaFinanciera {
  id          String   @id @default(cuid())
  nombre      String   // ej: "Alimentación", "Salarios", "Transporte"
  tipo        String   // INGRESO | GASTO
  ambito      String   // NEGOCIO | PERSONAL | AMBOS
  icono       String?  // emoji opcional
  color       String?  // hex opcional
  keywords    String?  // palabras clave para clasificación automática (coma-separadas)
  activa      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  movimientos MovimientoCajaExtendido[]

  @@index([tipo, ambito])
  @@unique([nombre, ambito])
}

// =====================================================
// MovimientoCajaExtendido — Extiende MovimientoCaja con ámbito + categoría
// =====================================================
model MovimientoCajaExtendido {
  id              String   @id @default(cuid())
  movimientoId    String   @unique // FK al MovimientoCaja original
  movimiento      MovimientoCaja @relation(fields: [movimientoId], references: [id])
  ambito          String   @default("NEGOCIO") // NEGOCIO | PERSONAL
  categoriaId     String?
  categoria       CategoriaFinanciera? @relation(fields: [categoriaId], references: [id])
  subcategoria    String?  // ej: "Almuerzo", "Gasolina"
  esRecurrente    Boolean  @default(false)
  notasAnalisis   String?  // análisis generado por el bot
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([ambito])
  @@index([categoriaId])
}

// =====================================================
// Presupuesto — Presupuestos por categoría y período
// =====================================================
model Presupuesto {
  id              String   @id @default(cuid())
  nombre          String   // ej: "Presupuesto Hogar Marzo"
  ambito          String   // NEGOCIO | PERSONAL
  categoriaId     String?
  montoLimite     Float
  periodo         String   // MENSUAL | SEMANAL | ANUAL
  fechaInicio     DateTime
  fechaFin        DateTime?
  activo          Boolean  @default(true)
  alertaEnPorcentaje Int  @default(80) // alertar al 80% del límite
  creadoPor       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([ambito, activo])
  @@index([categoriaId])
}

// =====================================================
// MetaFinanciera — Metas de ahorro / pago de deudas / etc.
// =====================================================
model MetaFinanciera {
  id              String   @id @default(cuid())
  nombre          String   // ej: "Ahorrar para vehículo"
  descripcion     String?
  tipo            String   // AHORRO | PAGAR_DEUDA | COMPRAR_BIEN | CREAR_EMPRESA | FONDO_EMERGENCIAS | JUBILACION | OTRO
  ambito          String   // NEGOCIO | PERSONAL
  montoObjetivo   Float
  montoActual     Float    @default(0)
  fechaObjetivo   DateTime?
  plazo           String?  // CORTO | MEDIANO | LARGO
  estado          String   @default("ACTIVA") // ACTIVA | COMPLETADA | CANCELADA | PAUSADA
  creadoPor       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([ambito, estado])
}

// =====================================================
// EventoFinanciero — Calendario / Agenda financiera (Módulo 6)
// =====================================================
model EventoFinanciero {
  id           String   @id @default(cuid())
  titulo       String
  descripcion  String?
  fecha        DateTime
  tipo         String   @default("OTRO") // PAGO | RECORDATORIO | REPORTE | OTRO
  monto        Float?
  categoria    String?
  origen       String   @default("MANUAL") // MANUAL | BOT | PAGO | SISTEMA
  completado   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([fecha])
  @@index([tipo])
  @@index([completado])
}

// =====================================================
// MovimientoFinanciero — Movimientos del módulo Contabilidad
// =====================================================
model MovimientoFinanciero {
  id              String   @id @default(cuid())
  tipo            String   // INGRESO | GASTO
  categoria       String
  descripcion     String
  monto           Float
  fecha           DateTime @default(now())
  metodoPago      String?
  responsable     String?
  notas           String?
  ambito          String   @default("NEGOCIO") // NEGOCIO | PERSONAL
  planFinancieroId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([ambito, fecha])
  @@index([tipo])
  @@index([categoria])
}

// =====================================================
// RenovacionPrestamo — Histórico de renovaciones de préstamos
// =====================================================
model RenovacionPrestamo {
  id                      String   @id @default(cuid())
  prestamoOriginalId      String
  prestamoNuevoId         String
  saldoAnterior           Float
  nuevoMontoPrestado      Float
  nuevaTasaInteresAnual   Float
  nuevoPlazoMeses         Int
  nuevaFrecuencia         String
  nuevoNumeroCuotas       Int
  nuevaMontoCuota         Float
  nuevoTotalInteres       Float
  nuevoTotalPagar         Float
  fechaInicioPago         DateTime
  motivoRenovacion        String?
  usuarioNombre           String
  createdAt               DateTime @default(now())

  @@index([prestamoOriginalId])
  @@index([prestamoNuevoId])
}

// =====================================================
// AlertaFinanciera — Alertas inteligentes detectadas por el bot
// =====================================================
model AlertaFinanciera {
  id              String   @id @default(cuid())
  tipo            String   // GASTO_EXCESIVO | ENDEUDAMIENTO_ALTO | RIESGO_LIQUIDEZ | VENCIMIENTO_PROXIMO | PAGO_OLVIDADO | PRESUPUESTO_EXCEDIDO | OPORTUNIDAD_AHORRO
  ambito          String   // NEGOCIO | PERSONAL | AMBOS
  severidad       String   // INFO | WARNING | CRITICAL
  titulo          String
  descripcion     String
  montoInvolucrado Float?
  entidadRefId    String?  // ej: presupuestoId, metaId, prestamoId
  atendida        Boolean  @default(false)
  atendidaPor     String?
  atendidaAt      DateTime?
  createdAt       DateTime @default(now())

  @@index([ambito, atendida])
  @@index([createdAt])
}

// =====================================================
// HUB IA — Asistente IA Operativo (v1.0)
// Modelos para el Hub de Inteligencia Artificial:
//   - HubIAConfig: configuración de proveedores (API keys cifradas)
//   - HubIAConversation: sesiones de chat del admin
//   - HubIAMensaje: mensajes (user/assistant/tool) con tokens y costo
//   - HubIAAccion: acciones ejecutadas por la IA (auditoría detallada)
//   - HubIAUso: tracking de consumo por proveedor/modelo/usuario
// =====================================================

model HubIAConfig {
  id              String   @id @default(cuid())
  clave           String   @unique
  valor           String   // API keys se almacenan cifradas con encryptSensitive()
  descripcion     String?
  updatedAt       DateTime @updatedAt
  updatedBy       String?
}

model HubIAConversation {
  id              String   @id @default(cuid())
  usuarioId       String?
  usuarioNombre   String
  titulo          String   @default("Nueva conversación")
  provider        String?  // zai | openai | auto
  modelo          String?
  modo            String   @default("consultivo") // consulta | planificacion | supervisado | ejecucion | automatico
  pausada         Boolean  @default(false)
  contexto        String?  // JSON con estado/resumen
  mensajeCount    Int      @default(0)
  totalTokens     Int      @default(0)
  totalCosto      Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  mensajes        HubIAMensaje[]

  @@index([usuarioId])
  @@index([createdAt])
}

model HubIAMensaje {
  id              String   @id @default(cuid())
  conversationId  String
  role            String   // user | assistant | tool | system
  contenido       String
  provider        String?  // zai | openai | fallback
  modelo          String?
  toolName        String?  // si role=tool, nombre de la herramienta
  toolCallId      String?
  toolArgs        String?  // JSON de args
  toolResult      String?  // JSON de resultado
  tokensInput     Int      @default(0)
  tokensOutput    Int      @default(0)
  costo           Float    @default(0)
  latencyMs       Int      @default(0)
  aprobado        Boolean? // null si no requiere aprobación, true/false si sí
  aprobadoPor     String?
  aprobadoAt      DateTime?
  createdAt       DateTime @default(now())
  conversation    HubIAConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

model HubIAAccion {
  id              String   @id @default(cuid())
  conversationId  String?
  usuarioId       String?
  usuarioNombre   String
  provider        String?
  modelo          String?
  toolName        String
  modulo          String   // clientes | prestamos | pagos | configuracion | sistema
  entidadId       String?
  entidadNombre   String?
  args            String?  // JSON
  resultado       String?  // JSON
  estado          String   // propuesta | aprobada | ejecutada | fallida | bloqueada
  riesgo          String   @default("bajo") // bajo | medio | alto | critico
  ipOrigen        String?
  userAgent       String?
  errorMessage    String?
  createdAt       DateTime @default(now())

  @@index([conversationId])
  @@index([usuarioId])
  @@index([toolName])
  @@index([estado])
  @@index([createdAt])
}

model HubIAUso {
  id              String   @id @default(cuid())
  usuarioId       String?
  usuarioNombre   String
  conversationId  String?
  provider        String   // zai | openai
  modelo          String
  tokensInput     Int
  tokensOutput    Int
  costo           Float
  exito           Boolean  @default(true)
  errorMessage    String?
  createdAt       DateTime @default(now())

  @@index([usuarioId])
  @@index([provider, createdAt])
  @@index([createdAt])
}

// =====================================================
// MemoriaBot — Memoria persistente de conversaciones por bot + usuario
// Permite que cada bot recuerde el contexto, hechos clave y preferencias
// del usuario a lo largo de múltiples sesiones.
// =====================================================
model MemoriaBot {
  id              String   @id @default(cuid())
  botTipo         String   // CHAT_CLIENTES | ADMIN_SISTEMA | JURIDICO | PAGOS | etc.
  usuarioId       String?  // ID del usuario/cliente/abogado (null si es anónimo)
  usuarioNombre   String?  // nombre legible del usuario
  conversacionId  String?  // ID de la conversación (ConversacionChat.id / HubIAConversation.id)
  // === Tipo de memoria ===
  tipoMemoria     String   // CONTEXTO | HECHO | PREFERENCIA | RESUMEN
  //  CONTEXTO     = últimos N mensajes del diálogo (rol + texto)
  //  HECHO        = dato específico que el bot debe recordar (ej: "cliente tiene 2 préstamos")
  //  PREFERENCIA  = configuración del usuario (ej: "prefiere ser llamado por nombre")
  //  RESUMEN      = síntesis periódica de la conversación (cuando se excede el límite)
  categoria       String?  // ej: "SALDOS", "PAGOS", "MORA", "DATOS_PERSONALES"
  contenido       String   // texto de la memoria
  // === Metadatos ===
  peso            Float    @default(1.0)  // peso de relevancia (decae con el tiempo)
  vecesRecordada  Int      @default(0)    // cuántas veces se ha usado esta memoria
  ultimaRecuperada DateTime?
  expiresAt       DateTime? // null = no expira; fecha = memoria temporal
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([botTipo, usuarioId])
  @@index([botTipo, conversacionId])
  @@index([tipoMemoria])
  @@index([createdAt])
}

// =====================================================
// AprendizajeBot — Aprendizajes persistentes generados por uso real
// Cuando el bot detecta que una nueva pregunta no está en el dataset,
// la registra aquí para que el equipo la revise y apruebe.
// =====================================================
model AprendizajeBot {
  id              String   @id @default(cuid())
  botTipo         String   // CHAT_CLIENTES | JURIDICO | PAGOS | etc.
  pregunta        String   // pregunta original del usuario
  respuestaDada   String?  // respuesta que el bot dio (puede ser "no encontrada")
  respuestaSugerida String? // respuesta propuesta para futuras consultas
  categoria       String?  // categoría tentativa
  frecuencia      Int      @default(1)  // cuántas veces se ha visto esta pregunta
  fuente          String   @default("USUARIO")  // USUARIO | ADMIN | SISTEMA | ENTRENAMIENTO
  estado          String   @default("PENDIENTE")  // PENDIENTE | APROBADO | RECHAZADO | INTEGRADO
  aprobadoPor     String?
  aprobadoAt      DateTime?
  observaciones   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([botTipo, estado])
  @@index([botTipo, categoria])
  @@index([estado])
  @@index([createdAt])
}
