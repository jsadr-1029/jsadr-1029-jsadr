  revisadoPor      String?
  fechaRevision    DateTime?
  prestamoCreadoId String?
  fechaConversion  DateTime?
  historialEstados String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@index([estado])
  @@index([clienteId])
}

